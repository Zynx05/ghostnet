# Copy this file to .env to change how the backend runs on your laptop.
# .env is in .gitignore, so it never reaches GitHub.
#
# Leave DATABASE_URL out entirely and the backend uses SQLite at
# backend/ghostnet.db. Nothing to install. That is the normal way to work.
#
# Set it to a PostgreSQL address when you want to test against the real thing:
# DATABASE_URL=postgresql://ghostnet:ghostnet@localhost:5432/ghostnet
#
# Browser addresses allowed to call this API, separated by commas.
# ALLOWED_ORIGINS=http://localhost:3000
